@page
@model FridgeBuddyFrontend.Pages.FridgeBuddy.CreateModel
@{
    ViewData["Title"] = "Adding New Ingredient";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="item.Name" class="form-label">Name</label>
                    <input asp-for="item.Name" class="form-control" />
                    <span asp-validation-for="item.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="item.Quantity" class="form-label">Quantity</label>
                    <input asp-for="item.Quantity" class="form-control" type="number" min="1" max="20" />
                    <span asp-validation-for="item.Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="item.StorageType" class="form-label">Storage Type</label>
                    <select asp-for="item.StorageType" class="form-control">
                        <option value="">Select Storage Type</option>
                        <option>Refrigerated</option>
                        <option>Frozen</option>
                    </select>
                    <span asp-validation-for="item.StorageType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="item.Category" class="form-label">Category</label>
                    <select asp-for="item.Category" class="form-control">
                        <option value="">Select Category</option>
                        <option>Fruit</option>
                        <option>Seafood</option>
                        <option>Vegetable</option>
                        <option>Dairy</option>
                        <option>Meat</option>
                        <option>etc</option>
                    </select>
                    <span asp-validation-for="item.Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="item.PurchaseDate" class="form-label">Purchase Date</label>
                    <input asp-for="item.PurchaseDate" class="form-control" type="date" />
                </div>

                <div class="mb-3">
                    <label asp-for="item.ExpirationDate" class="form-label">Expiration Date</label>
                    <input asp-for="item.ExpirationDate" class="form-control" type="date" />
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
